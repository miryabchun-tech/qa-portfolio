      "name": "GET Requests",
      "item": [
        {
          "name": "API-001 - Get all posts",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/posts"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response is a JSON array\", function () {",
                  "    pm.expect(pm.response.json()).to.be.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"Posts contain expected fields\", function () {",
                  "    const post = pm.response.json()[0];",
                  "    pm.expect(post).to.have.property(\"userId\");",
                  "    pm.expect(post).to.have.property(\"id\");",
                  "    pm.expect(post).to.have.property(\"title\");",
                  "    pm.expect(post).to.have.property(\"body\");",
                  "});"
                ]
              }
            }
          ]
        },
